# Postgres
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
POSTGRES_PORT=5432

# Backend
BACKEND_PORT=8000
# DATABASE_URL is assembled from the POSTGRES_* vars inside compose.yaml,
# but you can override it here if you point at an external database.
# DATABASE_URL=postgresql+psycopg://app:app@db:5432/app
# Signs session cookies (required). Use a long random value in .env, e.g.
# `python -c "import secrets; print(secrets.token_urlsafe(32))"`.
SESSION_SECRET=change-me-to-a-long-random-string

# Frontend
FRONTEND_PORT=5173
# URL the browser uses to reach the backend. Baked in at Vite build/dev time.
VITE_API_URL=http://localhost:8000

# Amazon Bedrock (paper-search + reproducibility-scoring + code-generation, all
# via LangChain). BEDROCK_MODEL_ID has no default — the backend fails to start
# without it. Must be a model id (or region-prefixed inference profile, e.g.
# us.anthropic.claude-haiku-4-5-20251001-v1:0) your account can invoke.
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
AWS_REGION=us-east-1
# AWS credentials for Bedrock (standard provider chain also works).
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key

# code-generation mock mode: when true, generation returns a canned artifact
# without calling Bedrock (deterministic dev/test). Safe default: false.
CODEGEN_MOCK=false
# Max output tokens for code/review generation. Raise if long REVIEW.md or
# generated files get truncated; cap to the model's output limit. Default 8192.
CODEGEN_MAX_TOKENS=8192

# GitHub repo inspection (reproducibility-scoring). GITHUB_TOKEN is a SECRET —
# optional (absence degrades to unauthenticated, lower-rate access); when set it
# raises the API rate limit. Never commit a real token. GITHUB_API_BASE must be
# HTTPS (startup rejects a non-HTTPS value).
GITHUB_API_BASE=https://api.github.com
# GITHUB_TOKEN=ghp_your_token_here

# writer-workspace upload/extraction limits (not secrets; tune as needed).
# Bytes for the PDF manuscript, the source archive, and the total unpacked
# source; a file count cap; and the Git codeload fetch timeout (seconds).
MAX_MANUSCRIPT_BYTES=26214400
MAX_SOURCE_ARCHIVE_BYTES=52428800
MAX_SOURCE_TOTAL_BYTES=104857600
MAX_SOURCE_FILES=5000
GIT_FETCH_TIMEOUT_SECONDS=60
