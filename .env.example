# Postgres
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
POSTGRES_PORT=5432

# Backend
BACKEND_PORT=8000
# DATABASE_URL is assembled from the POSTGRES_* vars inside compose.yaml,
# but you can override it here if you point at an external database.
# DATABASE_URL=postgresql+psycopg://app:app@db:5432/app
# Signs session cookies (required). Use a long random value in .env, e.g.
# `python -c "import secrets; print(secrets.token_urlsafe(32))"`.
SESSION_SECRET=change-me-to-a-long-random-string

# Frontend
FRONTEND_PORT=5173
# URL the browser uses to reach the backend. Baked in at Vite build/dev time.
VITE_API_URL=http://localhost:8000

# Amazon Bedrock (paper-search: Query_Assist + Relevance_Assessment via LangChain).
# BEDROCK_MODEL_ID has no default — the backend fails to start without it.
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
AWS_REGION=us-east-1
# AWS credentials for Bedrock (standard provider chain also works).
AWS_ACCESS_KEY_ID=AKIA6HF7RX3XVOANFSIE
AWS_SECRET_ACCESS_KEY=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
