# Postgres
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
POSTGRES_PORT=5432

# Backend
BACKEND_PORT=8000
# DATABASE_URL is assembled from the POSTGRES_* vars inside compose.yaml,
# but you can override it here if you point at an external database.
# DATABASE_URL=postgresql+psycopg://app:app@db:5432/app

# Frontend
FRONTEND_PORT=5173
# URL the browser uses to reach the backend. Baked in at Vite build/dev time.
VITE_API_URL=http://localhost:8000
